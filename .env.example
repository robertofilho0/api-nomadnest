NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nomadnest
DATABASE_POOL_MAX=10
CORS_ORIGIN=*

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# Opcional: sem RABBITMQ_URL as notificações são geradas em memória
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=nomadnest.notifications
