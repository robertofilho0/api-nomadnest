{
  "name": "api-nomadnest",
  "version": "2.0.0",
  "description": "API de reservas de coworking para nômades digitais com Express 5, MongoDB, JWT, busca por disponibilidade e prevenção de conflitos",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "booking",
    "coworking",
    "jwt"
  ],
  "author": "Roberto Filho",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "morgan": "^1.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
